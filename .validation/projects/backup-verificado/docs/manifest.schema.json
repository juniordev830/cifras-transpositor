{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifesto Backup Verificado v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "snapshot",
    "created_unix_seconds",
    "entries"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "created_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "hash"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
